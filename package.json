    "test": "node --test",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.6",
    "@supabase/supabase-js": "2.110.0",
    "better-auth": "^1.6.23",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "typescript": "^7.0.2",
    "wrangler": "4.131.1"
  }
}
