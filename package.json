{
  "name": "conways-game-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:worker": "node scripts/build-worker-assets.mjs",
    "dev": "node server.mjs",
    "dev:worker": "npm run build:worker && wrangler dev",
    "deploy:worker": "npm run build:worker && wrangler deploy",
    "test:e2e": "playwright test",
    "test:supabase:live": "node --test src/community-repository.supabase.integration.test.js",
    "db:migrate": "node scripts/migrate-postgres.mjs",
